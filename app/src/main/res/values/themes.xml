<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AniUaDownloader" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/aniyomi_bg</item>
        <item name="colorSurface">@color/aniyomi_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/aniyomi_surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/aniyomi_bg</item>
        <item name="android:navigationBarColor">@color/aniyomi_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.AniUaDownloader.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
