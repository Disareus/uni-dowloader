<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/aniyomi_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/aniyomi_surface_highlight"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- Checkbox for batch selection -->
        <CheckBox
            android:id="@+id/cb_episode_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary_variant" />

        <!-- Episode Number Badge -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_episode_badge">

            <TextView
                android:id="@+id/tv_episode_num_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="01" />
        </FrameLayout>

        <!-- Episode Title & Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_episode_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Серія 1" />

            <TextView
                android:id="@+id/tv_episode_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="Сезон 1" />
        </LinearLayout>

        <!-- Single Episode Download Icon Button -->
        <ImageButton
            android:id="@+id/btn_single_download"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Download this episode"
            android:src="@android:drawable/stat_sys_download"
            app:tint="@color/text_secondary" />

        <!-- Single Episode Play (ExoPlayer) Icon Button -->
        <ImageButton
            android:id="@+id/btn_play_preview"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play preview"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/accent_cyan" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
